# Managed by Ansible (role obsidian_web).
services:
  obsidian:
    image: {{ obsidian_web_image }}
    container_name: obsidian-web
    environment:
      - PUID={{ obsidian_web_uid }}
      - PGID={{ obsidian_web_gid }}
      - TZ={{ base_timezone }}
      - CUSTOM_USER={{ username }}
      - PASSWORD={{ obsidian_web_password }}
    volumes:
      - {{ obsidian_web_dir }}/config:/config
      - {{ obsidian_web_vault }}:/vault
    ports:
      # Loopback only: Docker bypasses ufw for published ports.
      - 127.0.0.1:{{ obsidian_web_local_port }}:3001
    shm_size: "1gb"
    restart: unless-stopped
